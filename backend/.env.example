# ============================================================
# Payla — Environment Template
# ============================================================
# Copy to .env and fill in real values:
#   cp .env.example .env       (Unix)
#   Copy-Item .env.example .env   (PowerShell)
#
# Never commit .env. It is gitignored.
# ============================================================


# ------------------------------------------------------------
# Core
# ------------------------------------------------------------

ENVIRONMENT=development
DEBUG=True

# Canonical base for API callbacks and absolute links
BACKEND_URL=http://127.0.0.1:8000

# Premium paylink domain (Silver feature)
VIP_BASE_URL=https://payla.vip

# Base for browser redirects and client-facing links
FRONTEND_URL=http://127.0.0.1:8000

# Paystack post-checkout redirect
SUBSCRIPTION_CALLBACK_URL=http://127.0.0.1:8000/subscription

# Base for verification links
APP_BASE_URL=http://127.0.0.1:8000


# ------------------------------------------------------------
# Firebase
# ------------------------------------------------------------
# Base64-encoded service account JSON.
# Encode with:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\service-account.json"))
# Or on Unix:
#   base64 -w 0 path/to/service-account.json

PAYLA_FIREBASE_KEY=

# Optional path fallback. Leave empty if PAYLA_FIREBASE_KEY is set.
GOOGLE_APPLICATION_CREDENTIALS=


# ------------------------------------------------------------
# Paystack
# ------------------------------------------------------------

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_PAYLA=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_PAYLA=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Toggle client-paid fees. "true" or "false".
PAYSTACK_CLIENT_INVOICE_FEES_ENABLED=false

# Plan codes. Create these in the Paystack dashboard, then paste the codes.
PAYSTACK_FOUNDING_SILVER_MONTHLY_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_FOUNDING_SILVER_YEARLY_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SILVER_MONTHLY_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SILVER_YEARLY_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# Pricing (NGN, whole naira, no commas or symbols)
# ------------------------------------------------------------

PAYLA_SILVER_MONTHLY_PRICE_NGN=7500
PAYLA_SILVER_YEARLY_PRICE_NGN=75000
PAYLA_FOUNDING_SILVER_MONTHLY_PRICE_NGN=5000
PAYLA_FOUNDING_SILVER_YEARLY_PRICE_NGN=50000


# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legacy SMTP fallback. Leave empty unless needed.
GMAIL_USER=
GMAIL_PASS=
LAYLA_USER=
LAYLA_EMAIL_PASS=


# ------------------------------------------------------------
# SMS / WhatsApp
# ------------------------------------------------------------
# WhatsApp tokens are provisioned but unused until Meta approval.
# The frontend gate lives in frontend/js/config.js
# (WHATSAPP_CHANNEL_STATUS).

TERMII_API_KEY=
TERMII_SENDER_ID=Payla

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=


# ------------------------------------------------------------
# Storage (Cloudinary)
# ------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ------------------------------------------------------------
# Worker intervals
# ------------------------------------------------------------

REMINDER_CHECK_INTERVAL_SECONDS=60
REMINDER_MAX_RETRIES=3
REMINDER_RETRY_INTERVAL_SECONDS=300
REMINDER_LOCK_TIMEOUT_MINUTES=10